{
  "name": "code-kanban",
  "displayName": "Code Kanban",
  "description": "A repository-specific Markdown kanban board with numbered story cards.",
  "version": "0.1.0",
  "publisher": "andrewvelez",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/andrewvelez/code-kanban.git" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other", "Visualization"],
  "main": "./dist/extension.cjs",
  "activationEvents": ["onWebviewPanel:code-kanban.board"],
  "contributes": {
    "commands": [
      { "command": "code-kanban.open", "title": "Open Kanban Board", "category": "Code Kanban" },
      { "command": "code-kanban.addStory", "title": "New Story", "category": "Code Kanban" }
    ]
  },
  "scripts": {
    "build": "node build.js",
    "vscode:prepublish": "npm run build",
    "test": "node --test test/*.test.js",
    "test:ui": "playwright test",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@tiptap/core": "^3.15.3",
    "@tiptap/starter-kit": "^3.15.3",
    "tiptap-markdown": "^0.9.0",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.0"
  }
}
